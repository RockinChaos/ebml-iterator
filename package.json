{
  "version": "1.2.0",
  "name": "@rockinchaos/ebml-iterator",
  "license": "MIT",
  "packageManager": "pnpm@10.34.1",
  "description": "A minimal, dependency-free EBML streaming parser and encoder for Node.js.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "lint": "eslint src test eslint.config.js",
    "lint:fix": "eslint src test eslint.config.js --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier src test .github package.json tsconfig.json eslint.config.js .prettierrc.json \"*.md\" --write --no-error-on-unmatched-pattern",
    "format:check": "prettier src test .github package.json tsconfig.json eslint.config.js .prettierrc.json \"*.md\" --check --no-error-on-unmatched-pattern",
    "check": "run-s lint typecheck format:check test",
    "test": "jasmine test/*",
    "reencode": "node test/reencode.spec.js"
  },
  "keywords": [],
  "author": {
    "name": "RockinChaos",
    "url": "https://github.com/RockinChaos"
  },
  "contributors": [
    {
      "name": "ThaUnknown",
      "url": "https://github.com/ThaUnknown"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RockinChaos/ebml-iterator.git"
  },
  "bugs": {
    "url": "https://github.com/RockinChaos/ebml-iterator/issues"
  },
  "files": [
    "src/*"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.6",
    "assert": "^2.1.0",
    "ebml-stream": "^1.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jasmine": "^7.0.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.9",
    "typescript": "6.0.3"
  }
}
